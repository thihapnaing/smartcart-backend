# Copy to .env (gitignored) and adjust before running `docker compose up`.
# docker compose loads .env automatically for ${VAR} substitution in
# docker-compose.yml — these were previously hardcoded directly in that file.

MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=smartcart_db
MYSQL_USER=smartcart_user
MYSQL_PASSWORD=smart-cart_password

# Signing key for JWT auth (nus.iss.smartcart.backend.security.JwtService).
# Previously hardcoded in application.properties - generate your own random
# value for real deployments instead of reusing this one.
JWT_SECRET=SmartCartSmartCartSmartCartSecretKey2026ForJWTAuthentication123456