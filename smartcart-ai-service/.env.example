# Copy to .env (git/dockerignored) and fill in real values.
# docker-compose picks this up automatically via env_file if present.

# One of these is required for the AI service to respond to chat/recommendation requests.
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Only needed if running outside docker-compose / against non-default hosts.
# SMARTCART_BACKEND_URL=http://localhost:8080
# SPRING_BOOT_URL=http://localhost:8080
# PORT=8001
